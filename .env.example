# ---------------------------------------------------------------------------
# BankFlow Analytics - Environment Variables (example)
# Copy this file to `.env` and adjust values for your local environment.
# ---------------------------------------------------------------------------

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=bankflow-producer
KAFKA_TOPIC_TRANSACTIONS=bank_transactions
KAFKA_TOPIC_QUARANTINE=bank_transactions_quarantine
KAFKA_TOPIC_ANOMALY=bank_transactions_anomaly
KAFKA_NUM_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# Spark
SPARK_APP_NAME=BankFlowStreaming
SPARK_MASTER=local[*]
SPARK_SHUFFLE_PARTITIONS=8

# Storage paths (relative to repo root, or absolute in containers)
BRONZE_PATH=./data/bronze/transactions
SILVER_PATH=./data/silver/transactions
QUARANTINE_PATH=./data/quarantine/transactions
CHECKPOINT_BASE_PATH=./data/checkpoints
GOLD_SQLITE_PATH=./data/gold/bankflow_gold.db

# Generator
GENERATOR_RATE_PER_SEC=5
GENERATOR_ANOMALY_RATIO=0.08
GENERATOR_DURATION_SECONDS=0

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:////opt/airflow/airflow.db
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Logging
LOG_LEVEL=INFO
